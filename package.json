        "markdownTwain.provider": {
          "type": "string",
          "scope": "application",
          "default": "openai",
          "markdownDescription": "The LLM provider translations are sent to. `custom` uses `#markdownTwain.customBaseUrl#`. [Set Up LLM Connection](command:markdownTwain.setUpConnection)",
          "enum": [
            "openai",
            "openrouter",
            "deepseek",
            "ollamaCloud",
            "custom"
          ],
          "enumItemLabels": [
            "OpenAI",
            "OpenRouter",
            "DeepSeek",
            "Ollama Cloud",
            "Custom"
          ]
        },
        "markdownTwain.customBaseUrl": {
          "type": "string",
          "scope": "application",
          "default": "",
          "markdownDescription": "The base URL of the Custom provider, used as entered, for example `http://localhost:11434/v1`. `/chat/completions` is added to it. [Set Up LLM Connection](command:markdownTwain.setUpConnection)"
        },
        "markdownTwain.customApiKeyEnv": {
          "type": "string",
          "scope": "application",
          "default": "",
          "markdownDescription": "The name of the environment variable that holds the Custom provider's API key. Leave it empty when a key is saved or the provider needs none. [Set API Key](command:markdownTwain.setApiKey)"
        },
        "markdownTwain.model": {
          "type": "string",
          "scope": "application",
          "default": "",
          "markdownDescription": "The model ID translations use. Empty means the LLM connection isn't set up. [Select Model](command:markdownTwain.selectModel)"
        },
        "markdownTwain.reasoningEffort": {
          "type": "string",
          "scope": "application",
          "default": "default",
          "markdownDescription": "How hard the model thinks before translating. `default` sends nothing and leaves it to the model; `none` turns thinking off. [Set Reasoning Effort](command:markdownTwain.setReasoningEffort)",
          "enum": [
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --format=cjs --target=node20 --external:vscode --sourcemap",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.mts",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm build",
    "dev-host": "pnpm build && node scripts/dev-host.mjs",
    "sync:languages": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-languages.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.96.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.2",
    "markdown-it-front-matter": "^0.2.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}

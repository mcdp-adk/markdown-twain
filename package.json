{
  "name": "markdown-twain",
  "displayName": "markdown-twain",
  "description": "Translate the built-in Markdown preview with an LLM.",
  "version": "0.1.2",
  "private": true,
  "publisher": "mcdp-adk",
  "icon": "media/icon.png",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcdp-adk/markdown-twain.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "commands": [
      {
        "command": "markdownTwain.pickDisplayMode",
        "title": "Pick Display Mode",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.pickDisplayMode.originalOnly",
        "title": "markdown-twain: Original Only",
        "icon": "$(globe)"
      },
      {
        "command": "markdownTwain.pickDisplayMode.bilingual",
        "title": "markdown-twain: Bilingual",
        "icon": "$(globe)"
      },
      {
        "command": "markdownTwain.pickDisplayMode.translationOnly",
        "title": "markdown-twain: Translation Only",
        "icon": "$(globe)"
      },
      {
        "command": "markdownTwain.showBilingual",
        "title": "Show Bilingual",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.showOriginalOnly",
        "title": "Show Original Only",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.showTranslationOnly",
        "title": "Show Translation Only",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.showLog",
        "title": "Show Log",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.setUpConnection",
        "title": "Set Up LLM Connection",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.selectModel",
        "title": "Select Model",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.setReasoningEffort",
        "title": "Set Reasoning Effort",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.setApiKey",
        "title": "Set API Key",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.clearApiKey",
        "title": "Clear API Key",
        "category": "markdown-twain"
      },
      {
        "command": "markdownTwain.testConnection",
        "title": "Test Connection",
        "category": "markdown-twain"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdownTwain.pickDisplayMode.originalOnly",
          "when": "false"
        },
        {
          "command": "markdownTwain.pickDisplayMode.bilingual",
          "when": "false"
        },
        {
          "command": "markdownTwain.pickDisplayMode.translationOnly",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "markdownTwain.pickDisplayMode.originalOnly",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && markdownTwain.displayMode == originalOnly",
          "group": "navigation@1"
        },
        {
          "command": "markdownTwain.pickDisplayMode.bilingual",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && markdownTwain.displayMode == bilingual",
          "group": "navigation@1"
        },
        {
          "command": "markdownTwain.pickDisplayMode.translationOnly",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && markdownTwain.displayMode == translationOnly",
          "group": "navigation@1"
        }
      ]
    },

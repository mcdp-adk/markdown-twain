{
  "name": "markdown-twain",
  "displayName": "markdown-twain",
  "description": "Translate the built-in Markdown preview with an LLM.",
  "version": "0.0.1",
  "private": true,
  "publisher": "mcdp-adk",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcdp-adk/markdown-twain.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --format=cjs --target=node20 --external:vscode --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm build",
    "dev-host": "pnpm build && node scripts/dev-host.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.96.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.2",
    "markdown-it-front-matter": "^0.2.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
